# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/healthcare_appointments"

# Secret used to sign/verify session JWTs. Generate with e.g. `openssl rand -base64 48`.
JWT_SECRET="replace-with-a-long-random-secret"

# Google Gemini API key, used for pre-visit symptom analysis and post-visit
# patient-friendly summaries.
GEMINI_API_KEY="replace-with-your-gemini-api-key"

# Redis connection used by BullMQ for all background job queues (notifications,
# medication reminders, calendar sync, leave-conflict detection, LLM jobs).
REDIS_URL="redis://localhost:6379"

# SMTP credentials used by Nodemailer to send booking confirmation, reminder,
# cancellation, and leave-conflict emails.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="replace-with-smtp-username"
SMTP_PASSWORD="replace-with-smtp-password"
SMTP_FROM="Clinic <no-reply@clinic.example.com>"

# Google Calendar OAuth 2.0 client, from the Google Cloud Console (APIs & Services
# > Credentials > OAuth client ID, type "Web application"). Redirect URI must match
# an authorized redirect URI configured on that client, e.g.
# http://localhost:3000/api/integrations/google-calendar/callback
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google-calendar/callback"

# Base URL of the deployed app, used to build redirect targets after the Google
# OAuth consent flow completes.
APP_BASE_URL="http://localhost:3000"
